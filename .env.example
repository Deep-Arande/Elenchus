# Elenchus environment variables.
# Copy to `.env` and fill in. Never commit real keys (AGENTS.md section 8.7).

# LLM
GEMINI_API_KEY=
GEMINI_MODEL_FAST=          # current Flash-Lite model id (not 2.5)
GEMINI_MODEL_MAIN=          # current Flash model id
GEMINI_MODEL_PRO=           # current Pro model id

# Search & data
SEARCH_PROVIDER=firecrawl   # firecrawl | brave | exa
FIRECRAWL_API_KEY=
BRAVE_API_KEY=              # optional
EXA_API_KEY=                # optional
GOOGLE_FACTCHECK_API_KEY=

# Retrieval
EMBEDDING_BACKEND=gemini    # gemini (default) | bge-m3
GEMINI_EMBEDDING_MODEL=     # current Gemini embedding model id
EMBEDDING_DIM=1536          # output dimension for the Gemini embedding model
RERANKER_BACKEND=llm        # llm (default) | local
MATCH_THRESHOLD=0.75
SIMILAR_CLAIM_THRESHOLD=0.85

# Agent budgets
AGENT_MAX_STEPS=6
AGENT_MAX_SEARCHES=8
AGENT_MAX_PAGES=8
AGENT_TIMEOUT_SECONDS=90
CHECK_MAX_COST_USD=0.10

# Limits
ANON_CHECK_LIMIT=3
DAILY_CHECK_LIMIT=25
ADMIN_EMAILS=

# Supabase / DB / Redis
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=        # legacy projects only
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
TRACE_CONTENT=true

# App
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
